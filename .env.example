# Memba — Environment Variables
# Copy this file to .env and fill in your values.

# Backend
PORT=8080
GNO_RPC_URL=https://rpc.gno.land:443
GNO_CHAIN_ID=gnoland-1
DB_PATH=./memba.db
CORS_ORIGINS=http://localhost:5173,https://memba.club,https://memba.samourai.app
MEMBA_ENABLE_NATIVE_GNO_MULTISIG=false
# Native receipt checks: one node that may answer "absent", then an optional fallback
# (it may be a load-balanced pool) that may only confirm a receipt. See docs/NATIVE_MULTISIG.md.
MEMBA_NATIVE_GNO_RPC_URL=
MEMBA_NATIVE_GNO_RPC_FALLBACK_URL=
ED25519_SEED=  # 64-char hex string for deterministic ed25519 keypair (generate with: openssl rand -hex 32)

# NFT marketplace indexer — its OWN rpc, NOT GNO_RPC_URL (prod uses the Samouraï
# mainnet node). No NFT market is deployed on gno.land mainnet yet (the pearl-era
# stack retired with pearl on 2026-09-23); the indexer STAYS DISABLED until one
# ships AND its observability is wired
# (arm the memba_indexer_*{indexer="nft"} alerts first), and clear
# nft_indexer_state before re-enabling (the seed path won't rewind stale rows).
NFT_INDEXER_DISABLED=1
NFT_RPC_URL=https://rpc.mainnet.samourai.live
NFT_COLLECTION_REALM=gno.land/r/samcrew/memba_nft_v2
NFT_MARKET_REALM=gno.land/r/samcrew/memba_nft_market_v2
NFT_COLLECTION_ID=genesis
NFT_POLL_INTERVAL=60s
# Blocks to stay behind the chain tip for reorg-safety (default 5).
NFT_CONFIRMATIONS=5
# Realms the event tailer watches (v2 market + v2 collection + v3.1 + v3.2 engines).
# v3 is retired (UnregisterMarket'd 2026-06-27). v3.2 is the active engine since
# the 2026-07-10 ceremony; v3.1 stays registered but paused in wind-down.
NFT_WATCHED_REALMS=gno.land/r/samcrew/memba_nft_market_v2,gno.land/r/samcrew/memba_nft_v2,gno.land/r/samcrew/memba_nft_market_v3_1,gno.land/r/samcrew/memba_nft_market_v3_2
# Engines whose volume is sourced from Sale events only; their companion
# OfferAccepted/PurchaseConfirmed are metadata-only (prevents v2→v3 double-count).
# v3_2 added at the 2026-07-10 repoint. Its SeedSale replays emit "SaleSeeded" (NOT
# "Sale"), so watching both engines cannot double-count the migrated history.
NFT_SALE_VOLUME_REALMS=gno.land/r/samcrew/memba_nft_market_v3_1,gno.land/r/samcrew/memba_nft_market_v3_2
# One-time operator backfill lever: seeds a realm's indexer cursor to
# deployHeight-1 if it has no cursor row yet (INSERT OR IGNORE — will NOT
# rewind a realm whose cursor has already advanced). Format: comma-separated
# "realm_pkg_path@deployHeight" pairs.
# Example: NFT_SEED_REALM_CURSOR=gno.land/r/samcrew/memba_nft_market_v3@280000
NFT_SEED_REALM_CURSOR=

# GitHub OAuth (create at github.com/organizations/YOUR_ORG/settings/applications)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Frontend (VITE_ prefix for client-side access)
VITE_API_URL=http://localhost:8080
VITE_GNO_CHAIN_ID=mainnet
# Rehearsal-only: production builds reject true until a reviewed release.
VITE_ENABLE_NATIVE_GNO_MULTISIG=false
# No VITE_GNO_RPC_URL: no code reads it. Override a network's RPC with
# VITE_MAINNET_RPC_URL instead (see below).
VITE_GITHUB_CLIENT_ID=
# gnoweb/explorer host per network. It serves the "view on gnoweb" links only;
# namespace discovery goes through the RPC `vm/qpaths` query.
# gno.land MAINNET (chain id `gnoland-1`, HYPHEN — NOT the retired Betanet's
# `gnoland1`). The default network. Identity-check any node you point a build at
# (node_info.network == "gnoland-1": a 200 and DNS prove nothing). ⛔ There is
# NO mainnet faucet, by design.
# Set these only to point a build at a different node/indexer/explorer.
# VITE_MAINNET_RPC_URL=https://rpc.gno.land:443
# VITE_MAINNET_INDEXER_URL=https://indexer.gno.land/graphql/query  # browser uses the /api/indexer proxy
# VITE_MAINNET_EXPLORER_URL=https://gno.land
# Onyx (onyx-1) is the testnet: hidden in config.ts, reachable at /onyx/… or as a
# build default with VITE_GNO_CHAIN_ID=onyx. Its endpoints have no override.
# test13 (retired 2026-07-26) stays in config.ts only as the e2e and unit-test
# fixture network. Pearl, Sapphire, Topaz and Betanet have no entry: their old
# links redirect to mainnet.
# Bech32 address prefix ("g" on every gno.land network today; override for exotic chains).
# VITE_GNO_BECH32_PREFIX=g
VITE_DAO_REALM_PATH=gno.land/r/samcrew/memba_dao  # Canonical Memba dApp DAO. Note: samourai_dao is a separate Samouraï Coop DAO, not related.
# Realm path overrides — defaults (in config.ts) are the live realm paths
# (per-chain records: realm-versions.json); set these only when pointing at a
# redeployed/renamed realm.
# VITE_CANDIDATURE_REALM_PATH=gno.land/r/samcrew/memba_dao_candidature_v3
# VITE_CHANNELS_REALM_PATH=gno.land/r/samcrew/memba_dao_channels_v2
# VITE_ESCROW_REALM_PATH=gno.land/r/samcrew/escrow_v4
# VITE_FEED_REALM_PATH=gno.land/r/samcrew/memba_feed_v1
# VITE_REVIEWS_REALM_PATH overrides the reviews realm on EVERY network (validator, profile and app
# reviews): leave it unset, or a network whose own realm differs loses its reviews.
# Profile realm Memba OS reads and publishes profiles in (see profileRealmFor in config.ts):
# VITE_PROFILE_REALM_PATH=gno.land/r/samcrew/deps/demo/profile
VITE_GNOLOVE_API_URL=https://gnolove-api.samourai.live
VITE_GNO_MONITORING_API_URL=https://gnomonitoring.samourai.live  # Validator monikers/uptime (gnomonitoring API)

# Note: gnomonitoring keys chains by chain ID (e.g. "gnoland-1"); a network's
# `monitoringChain` in config.ts overrides it. Its live chain list is at /info.

# [Alerting] Clerk sign-in for the Alerts page. The production instance's key
# decodes to its Clerk frontend host (clerk.<primary domain>), which the CSP must allow.
# gnomonitoring checks the tokens; the Memba backend holds no Clerk secret.
# Only loaded by the Alerts page (lazy). No impact on other pages.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_

# [Hacker View] Samourai sentry RPC for high-frequency telemetry
# Convention: https://rpc.{chain}.samourai.live
# Example: https://rpc.mainnet.samourai.live
VITE_SAMOURAI_SENTRY_RPC_URL=
VITE_ENABLE_TEAMS=true
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
VITE_ENABLE_MARKETPLACE=true
# Marketplace v2 rebuild (build-out gate) — OFF until the new version is complete + reviewed, then flipped at cutover.
VITE_ENABLE_MARKETPLACE_V2=false
# Escrow functionality is now live in the Unified Marketplace.
VITE_ENABLE_SERVICES=false
# NFT — off by default. NOT safety-gated: safeFlags.ts does not list it, so
# "true" does not fail the build. The realm allowlist (REALM_ALLOWLIST in
# frontend/src/lib/config.ts) decides per network: mainnet lists no NFT
# realm, so enabling this flag alone opens nothing there.
VITE_ENABLE_NFT=false
# Membas Genesis curated mint: backend-driven, no frontend flag — the mint form
# self-enables when the backend endpoints respond. Ceremony-day backend envs:
#   MEMBA_ALLOWLIST_PROOFS_PATH, MEMBA_TICKET_COLLECTION_ID,
#   MEMBA_TICKET_URI_BASE, MEMBA_TICKET_PREFIX (see backend/fly.toml)
# Social feed (W7.2) — ordinary flag, no funds. Off until the memba_feed_v1
# realm is deployed (owner-executed) and the FEED_WATCHED_REALMS backend env is set.
VITE_ENABLE_FEED=false
# On-chain blog reads (memba_blog_v1) with static fallback; off until the realm is deployed + migrated
VITE_ENABLE_ONCHAIN_BLOG=false
# VITE_BLOG_REALM_PATH=gno.land/r/samcrew/memba_blog_v1
# Realm Explorer (W9 P0) — ordinary flag, no funds. Read-only realm viewer
# (qrender/qfile/qfuncs); no execution surface. Off by default.
VITE_ENABLE_EXPLORER=false
# App Store (W9) — ordinary flag. Reads memba_appstore_v3 on mainnet and
# memba_appstore_v2 elsewhere (VITE_APPSTORE_REALM_PATH overrides).
VITE_ENABLE_APPSTORE=false
# Which App Store realm the front end reads. Defaults per network: memba_appstore_v3 on
# mainnet, memba_appstore_v2 elsewhere. Set it only to point a network at another realm.
# VITE_APPSTORE_REALM_PATH=gno.land/r/samcrew/memba_appstore_v3
# Community reviews on App Store listings: ordinary flag, off by default. App reviews live in the
# network's reviews realm (gno.land/r/samcrew/memba_reviews_v2 on mainnet), beside validator and
# profile reviews; VITE_REVIEWS_REALM_PATH overrides that realm for all three.
VITE_ENABLE_APP_REVIEWS=false
# Space Invaders arcade game (Store). Leave false; owner flips to enable.
VITE_ENABLE_SPACE_INVADERS=false
# Space Invaders on-chain certify (M3 — opt-in daily-run submit; funds-free, not safety-gated).
# Needs VITE_ENABLE_SPACE_INVADERS too. Leave false until the backend certify lane is enabled.
VITE_ENABLE_SPACE_INVADERS_CERTIFY=false
# MEMBA: BARRICADE (G1 preview — funds-free daily lane-defense). Leave false; owner flips at reveal.
VITE_ENABLE_BARRICADE=false
# Token factory lane (GRC20 create/mint/transfer/burn UI). Ordinary flag.
VITE_ENABLE_TOKENS=false
# Community reviews (validators/profiles; memba_reviews_v1, reputation-only — no funds).
VITE_ENABLE_REVIEWS=false
# Feed reaction bar — needs the feed realm redeployed with the reaction methods (owner-executed).
VITE_ENABLE_REACTIONS=false
# Feed URL unfurls via the backend's SSRF-guarded link-preview proxy.
VITE_ENABLE_LINK_PREVIEWS=false
# Block Party daily game. Playing needs BOTH this flag (Netlify dashboard in
# prod) and the backend's BLOCKPARTY_ENABLED=1 (Fly secret) — while parked the
# backend answers Unimplemented on the entire BP surface, reads included.
# Backend seed source: BLOCKPARTY_SEED_RPC_URL (default: the Samouraï gno.land
# mainnet node https://rpc.mainnet.samourai.live:443) + BLOCKPARTY_SEED_CHAIN_ID
# (default gnoland-1) — override TOGETHER; seeding is single-node, no failover, and
# hard-fails on a chain-id mismatch so a wrong seed can never be minted.
# (A future rewards phase additionally needs the per-submission signature
# gate — unbuilt, deliberately.)
VITE_ENABLE_GAME=false
# GnoBuilders badges tab on profiles. Flip after the badge mint ceremony.
VITE_ENABLE_BADGES=false
# Agents surface (agent_registry realm). Ordinary flag; credits stay behind
# the safety-gated VITE_ENABLE_AGENT_CREDITS below.
VITE_ENABLE_AGENTS=false
# Profile Activity tab scan window in blocks (sized on test13, where ~40k ≈ the
# last 1.5–2 days — re-check against the network's block time); bounded because the
# indexer streams full history otherwise.
# VITE_PROFILE_ACTIVITY_WINDOW_BLOCKS=40000
# App Store self-service submission (/apps/submit; RegisterApp sends the exact 1-GNOT
# fee). Ordinary flag, de-gated 2026-07-10 on test13 (v3 deployed + seeded + sealed, fee
# path verified there). On mainnet it pays memba_appstore_v3's fee: verify that fee path
# there before enabling.
VITE_ENABLE_APPSTORE_SUBMIT=false

# AAA-0 safety-gated flags — these features have incomplete on-chain enforcement.
# Changing any to 'true' will fail CI (see safeFlags.ts safety gate).
# A1.a: Treasury spending is NOT yet enforced on-chain.
VITE_ENABLE_TREASURY_SPEND=false
# A5.ui: Agent credit deposits disabled until registry deployment is verified.
VITE_ENABLE_AGENT_CREDITS=false
# EVM network (Base): in development behind this flag; deploy-previews only until launch.
VITE_ENABLE_EVM=false

# Complete professional design preview; does not enable any feature capabilities.
# VITE_ENABLE_PRO_APP=true
# Memba OS (the desktop UI) — off by default. A build with it on fails unless the
# site ALSO sets MEMBA_OS_BETA_SITE=true (only the memba.club beta site does; never
# the production site). See frontend/src/os/osBuildGate.ts.
# VITE_MEMBA_OS=true

# DAO Analyst — free-tier LLM API keys (backend-only, never shipped to client)
GROQ_API_KEY=           # Groq free tier (Llama 3.3 70B) — https://console.groq.com
GOOGLE_AI_KEY=          # Google AI Studio free tier (Gemini 2.0 Flash) — https://aistudio.google.com
TOGETHER_API_KEY=       # Together.ai free tier (Mistral) — https://api.together.xyz
OLLAMA_URL=             # Optional: http://localhost:11434 for local Ollama fallback
OLLAMA_MODEL=           # Optional: model name for Ollama (default: llama3.2)

# IPFS Pinning — Lighthouse (avatars + App Store media, 5GB free)
# Server-side ONLY: read by the backend upload proxy (/api/upload/avatar,
# /api/upload/image, /api/upload/curation-evidence). Never a VITE_ var — the key
# must never reach the client bundle.
LIGHTHOUSE_API_KEY=

# JaaS (v2.9)
VITE_JAAS_APP_ID=

OPENROUTER_API_KEY=     # Single key for all 10 free models
ANALYST_CACHE_TTL=6h    # Optional, default 6 hours
# Backend analyst API (/api/analyst/consensus). OFF unless ANALYST_ENABLED is
# "true" or "1": the endpoint answers 503 otherwise, whatever VITE_ENABLE_ANALYST says.
ANALYST_ENABLED=
# Operator bearer (random, 32+ bytes): may force a cached report to regenerate
# and is not subject to the per-wallet cap. Unset = no operator access.
ANALYST_ADMIN_BEARER=
# Reports one wallet may generate per UTC day (default 5). 0 = wallets cannot
# generate reports at all (cached reports are still served). Cache hits are free.
ANALYST_DAILY_CAP_PER_WALLET=
# Launchpad solvency watcher. OFF unless LAUNCHPAD_WATCH_ENABLED=1, and it does not
# start without the webhook (a secret: Discord, or Telegram's sendMessage URL with
# chat_id). It reads one node (default rpc.mainnet.samourai.live) on GNO_CHAIN_ID.
LAUNCHPAD_WATCH_ENABLED=
LAUNCHPAD_WATCH_WEBHOOK_URL=
# LAUNCHPAD_WATCH_RPC_URL=https://rpc.mainnet.samourai.live
# Rehearsal only, refused unless GNO_CHAIN_ID=onyx-1: added to every stable balance.
# LAUNCHPAD_WATCH_INJECT_BALANCE_OFFSET=-1
VITE_ENABLE_ANALYST=true
