# Memba Frontend Environment Variables
# Copy to .env.local and fill in values

# Backend API URL (ConnectRPC). Empty = uses Vite proxy (dev) or same-origin (prod)
VITE_API_URL=

# ⚠️ This file is REFERENCE ONLY. Vite reads `.env*` from the REPO ROOT
# (vite.config.ts sets envDir: '..'), so a `.env.local` placed next to this
# file is ignored. Copy the repo-root `.env.example` instead.

# Gno network KEY (not the chain id): `mainnet` resolves to the on-wire chainId
# "gnoland-1" in config.ts. Pearl (`pearl`) was retired on 2026-09-23.
VITE_GNO_CHAIN_ID=mainnet

# NOTE: there is deliberately no VITE_GNO_RPC_URL here — no code reads it.
# The active RPC comes from the per-network entry in config.ts, overridable
# per network: VITE_MAINNET_RPC_URL (retired chains such as pearl keep their
# old VITE_PEARL_* names). ⚠️ VITE_MAINNET_* targets chain id `gnoland-1` (mainnet);
# betanet is `gnoland1`, a DIFFERENT chain. Setting a
# VITE_GNO_RPC_URL anywhere (including the Netlify dashboard) has no effect.

# [Hacker Mode] Samourai node RPC for direct high-frequency telemetry.
# Convention: https://rpc.{chain}.samourai.live
# When set, Hacker Mode will use this endpoint for /dump_consensus_state and /net_info.
# Ignored when the domain is not in TRUSTED_RPC_DOMAINS.
#
# mainnet (gnoland-1): https://rpc.mainnet.samourai.live
VITE_SAMOURAI_SENTRY_RPC_URL=

# Bech32 address prefix
VITE_GNO_BECH32_PREFIX=g

# JaaS (Jitsi-as-a-Service) App ID for lobby-free voice/video rooms.
# Get a free App ID at https://jaas.8x8.vc — leave empty to fallback to meet.jit.si.
VITE_JAAS_APP_ID=

# Realm path overrides (optional — defaults to v2 paths in config.ts)
# VITE_CHANNELS_REALM_PATH=gno.land/r/samcrew/memba_dao_channels_v2
# VITE_CANDIDATURE_REALM_PATH=gno.land/r/samcrew/memba_dao_candidature_v2

# Feature Flags (set to "true" to enable, empty or missing = disabled)
# These gate aspirational features behind Coming Soon overlays.
VITE_ENABLE_MARKETPLACE=
VITE_ENABLE_NFT=
VITE_ENABLE_SERVICES=
VITE_ENABLE_TEAMS=
VITE_ENABLE_REVIEWS=false
VITE_ENABLE_FEED=
VITE_ENABLE_GAME=false
VITE_ENABLE_EXPLORER=
VITE_ENABLE_APPSTORE=

# Gnolove backend URL override. Defaults to https://gnolove-api.samourai.live
# (see frontend/src/lib/config.ts). Set this if you're pointing at a
# local gnolove server for development; hosts outside
# TRUSTED_GNOLOVE_API_DOMAINS (config.ts) are ignored.
VITE_GNOLOVE_API_URL=

# Complete professional design preview; does not enable any feature capabilities.
# VITE_ENABLE_PRO_APP=true
# Memba OS (the desktop UI) — off by default. A build with it on fails unless the
# site ALSO sets MEMBA_OS_BETA_SITE=true (only the memba.club beta site does; never
# the production site). See src/os/osBuildGate.ts.
# VITE_MEMBA_OS=true
