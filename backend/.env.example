# Memba Backend Environment Variables
# Copy to .env and fill in values

# Server port (default: 8080)
PORT=8080

# SQLite database path (default: memba.db)
DB_PATH=memba.db

# Native multisig: off unless set to true, and only for the matching GNO_CHAIN_ID.
# Receipt checks: MEMBA_NATIVE_GNO_RPC_URL is one node, the only one that may answer
# "absent"; the optional fallback (it may be a pool) may only confirm a receipt.
MEMBA_ENABLE_NATIVE_GNO_MULTISIG=false
MEMBA_NATIVE_GNO_RPC_URL=
MEMBA_NATIVE_GNO_RPC_FALLBACK_URL=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Ed25519 seed for token signing (hex-encoded, 64 chars)
# Generate with: openssl rand -hex 32
ED25519_SEED=

# ── Activity feed ────────────────────────────────────────────────────────────
# gno tx-indexer GraphQL endpoint proxied by /api/indexer (the browser can't call
# it directly — no CORS). Defaults to the built-in gno.land mainnet indexer.
# INDEXER_GRAPHQL_URL=https://indexer.gno.land/graphql/query

# ── Safe Transaction Service proxy (EVM Multisig, /api/safe-tx/) ─────────────
# Off unless set: EIP-155 chain ids to serve (8453 = Base, 84532 = Base Sepolia).
# MEMBA_EVM_SAFE_CHAINS=84532
# Safe API key (developer.safe.global), sent upstream only, never to the browser.
# Without it the proxy runs keyless: 2 requests/s, 5,000 requests per 30 days per IP.
# SAFE_TX_SERVICE_API_KEY=

# ── Home snapshot ────────────────────────────────────────────────────────────
# RPC used by GetHomeSnapshot to read on-chain counts/pulse (defaults to NFT_RPC_URL,
# then the pinned samourai mainnet node). The public node rate-limits the Fly egress IP (#466).
HOME_SNAPSHOT_RPC_URL=https://rpc.mainnet.samourai.live
# Cache TTL for the assembled home snapshot (Go duration, default 30s).
HOME_SNAPSHOT_TTL=30s

# ── Feed stats ───────────────────────────────────────────────────────────────
# Cache TTL for GetFeedStats' header/rail counters (3 COUNT + most-replied),
# singleflight-deduped so a traffic spike collapses to one DB fan-out per window
# (Go duration, default 30s).
FEED_STATS_TTL=30s

# ── RPC failover ─────────────────────────────────────────────────────────────
# Backup RPC nodes tried (in order) when the primary *_RPC_URL above is
# unreachable (connection error, timeout, non-200). Comma-separated; unset/empty
# uses the built-in trusted gno.land mainnet list. A valid "no record" answer never
# triggers failover — only transport failures do.
# RPC_FALLBACK_URLS=https://rpc.gno.land:443,https://rpc.mainnet.samourai.live

# ── NFT indexer (Render-scrape metadata poller) ──────────────────────────────
# The NFT realms use their OWN rpc (not GNO_RPC_URL). Pinned samourai mainnet
# node — the public node rate-limits the Fly egress IP (#466). No NFT market is
# deployed on mainnet yet; the realm values below are pearl-era examples.
NFT_RPC_URL=https://rpc.mainnet.samourai.live
NFT_COLLECTION_REALM=gno.land/r/samcrew/memba_collections
NFT_MARKET_REALM=gno.land/r/samcrew/memba_nft_market_v3_2
NFT_COLLECTION_ID=genesis
# Metadata poll interval (Go duration). Default 60s.
NFT_POLL_INTERVAL=60s

# ── NFT event tailer (/block_results → normalized event tables) ───────────────
# Comma-separated realm pkg_paths to watch. Default: market + collection realms.
NFT_WATCHED_REALMS=gno.land/r/samcrew/memba_nft_market_v3_2,gno.land/r/samcrew/memba_collections
# First-run cursor floor: block height to start tailing from on a fresh DB.
# Set to a height at/just before the NFT realms were deployed to avoid scanning
# all of genesis. Default 265293 (the first samcrew mainnet deploy height,
# realm-versions.json `mainnet` — a placeholder: no NFT market ships on mainnet
# yet; set this to the market's deploy height when one does). Once the cursor
# is persisted in nft_indexer_state this is ignored.
NFT_START_BLOCK=265293
# Tailer sleep when caught up to the chain tip (Go duration). Default 3s.
NFT_TAILER_INTERVAL=3s

# ── Social feed indexer (W7.2 — memba_feed_v1 → feed_posts) ───────────────────
# Separate goroutine + cursor + raw ledger from the NFT tailer. UNSET = the feed
# indexer does not start (safe default while the realm is not yet deployed).
# Set to the deployed feed realm pkg_path to enable.
# FEED_WATCHED_REALMS=gno.land/r/samcrew/memba_feed_v1
# RPC for the feed tailer (defaults to NFT_RPC_URL — same chain). Must be a
# DIFFERENT node than GNO_RPC_URL (the public node throttles sustained polling).
# FEED_RPC_URL=https://rpc.mainnet.samourai.live
# First-run cursor floor (block height); ignored once persisted in
# feed_indexer_state. Default 265728 (gno.land mainnet memba_feed_v1 deploy
# height). Set to the feed realm's deploy height on any chain switch.
FEED_START_BLOCK=265728
# Confirmations depth and poll interval (Go duration). Defaults 5 / 3s.
FEED_CONFIRMATIONS=5
FEED_TAILER_INTERVAL=3s

# ── Quests ───────────────────────────────────────────────────────────────────
# Comma-separated addresses allowed to review (approve/reject) self-report quest
# claims. There is no built-in admin: unset/empty disables claim review for
# everyone. Use single-key wallets (a multisig can't sign the login).
# QUEST_ADMIN_ADDRESSES=g1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,g1yyyy...

# ── BARRICADE on-chain certify (verified arcade run submissions) ─────────────
# The /api/arcade/submit endpoint re-simulates a submitted input log in a node
# subprocess and stores only the reproduced result. UNSET/not "1" = the endpoint
# is 404 (safe default while the feature is dark and the realm isn't deployed).
# Needs `node` on PATH (the runtime image ships it). Set to "1" to enable.
# MEMBA_ARCADE_SUBMIT_ENABLED=1
# Override the node binary used to run the verify worker (default: node).
# MEMBA_ARCADE_NODE_BIN=node
# Per-authenticated-wallet submit cap (requests/min). Default 20.
# MEMBA_ARCADE_SUBMIT_RPM=20

# ── BARRICADE day-close attester (writes the competitive board on-chain) ─────
# DORMANT until BOTH are set. The attester re-attests each closed day's best
# verified run per wallet to the leaderboard realm via a dedicated low-privilege
# gnokey key (attester-pays). The key ceremony — generate + FUND the key and
# AddAttester it on the realm (NEVER the deploy multisig) — is an OWNER step, and
# the runtime image must carry `gnokey` (a build-stage add; see the ceremony
# runbook). Without gnokey on PATH the attester self-disables with a warning.
# MEMBA_ARCADE_ATTESTER_ENABLED=1
# gnokey keyring name of the attester key (NOT a raw secret; imported at boot).
# MEMBA_ARCADE_ATTESTER_KEY=arcade-attester
# The attester key's recovery MNEMONIC — a Fly SECRET (never a plain env / build
# arg / commit). start.sh imports it into the container keyring at boot, then
# unsets it so the app process never sees it. The Go process only ever holds the
# key NAME + the keyring password below, never this.
# ARCADE_ATTESTER_MNEMONIC=<24-word mnemonic>
# Keyring password gnokey uses to sign (fed on stdin — no TTY). Must match what
# start.sh imports with. A gnokey formality on the ephemeral container-only
# keyring, not a security control. Default: arcade.
# MEMBA_ARCADE_KEYRING_PW=arcade
# Leaderboard realm (default is the deployed path once the realm ceremony runs).
# MEMBA_ARCADE_REALM=gno.land/r/samcrew/memba_arcade_leaderboard_v1
# RPC for attestation broadcasts (defaults to GNO_RPC_URL).
# MEMBA_ARCADE_RPC_URL=
# gnokey binary (default: gnokey). Scan cadence + per-cycle broadcast-attempt cap.
# Failures and already-delivered transactions consume this attempt allowance too.
# This is not a persistent daily/monthly gas budget; keep the signer balance bounded.
# MEMBA_ARCADE_GNOKEY_BIN=gnokey
# MEMBA_ARCADE_ATTEST_INTERVAL=15m
# MEMBA_ARCADE_ATTEST_MAX_PER_CYCLE=100

# ── Private curation inbox (a collection's founder and the curation managers) ─
# /api/curation/inbox is OFF (503) while this is unset. 32 random bytes as 64
# hex characters (`openssl rand -hex 32`), used for nothing else: it seals
# message bodies at rest (AES-256-GCM). Keep two copies: the Fly secret and the
# owner's password manager, saved there BEFORE the secret is set
# (docs/SECRETS_ROTATION.md). A copy of the database is useless without the
# key, and losing both copies loses every stored message.
# NEVER replace it: rows sealed under another key do not open (they are served
# as "unreadable") and nothing re-seals them. The boot log line "curation inbox
# enabled" carries the key's fingerprint (key_id), never the key: a fingerprint
# that changes between two boots is an accidental key change.
# Needs GNO_CHAIN_ID, and MEMBA_ALLOW_UNSIGNED_AUTH off (the inbox refuses to
# start while unsigned logins are accepted). A session obtained unsigned stays
# valid 24 h: if unsigned logins were accepted in the last 24 h, wait, or rotate
# ED25519_SEED, before setting the key. Access is read from the chain on
# every request: the inbox answers "not available" while the curation realm is
# not published on that chain, during a chain halt, whenever every node is
# more than one minute behind, and for a collection id the realm does not know.
# Messages are kept 12 months: the backend deletes older ones at boot and then
# hourly, whether or not this key is set. A thread holds at most 2,000 at a time.
# MEMBA_CURATION_INBOX_KEY=
# Per-authenticated-wallet caps (requests/min): every request, reads included
# (default 30), and sends (default 12). Checked before the chain is asked.
# MEMBA_CURATION_INBOX_RPM=30
# MEMBA_CURATION_SEND_RPM=12
