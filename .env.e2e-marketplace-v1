# .env.e2e-marketplace-v1 — deterministic legacy Marketplace mobile E2E mode.
#
# The default dev server inherits an optional, gitignored root .env locally and
# falls back to pearl when CI has no such file. Neither environment is a stable
# contract for a test that deliberately exercises the legacy v1 Marketplace.
# `npm run dev:e2e-marketplace-v1` loads this committed mode on :5176 instead.
#
# Keep every lane-affecting value explicit: this surface needs the two v1 lanes
# on retired test13 (where their backing realms are allowlisted), while the v2
# component tree and unfinished token/agent lanes must remain off. This mode is
# used only by Playwright and is never loaded by production builds or deploys.

VITE_GNO_CHAIN_ID=test13
VITE_ENABLE_MARKETPLACE=true
VITE_ENABLE_MARKETPLACE_V2=false
VITE_ENABLE_NFT=true
VITE_ENABLE_SERVICES=true
# The app targets escrow_v4, which no network allowlists yet, so the Services
# lane would gate here. Keep the fixture on escrow_v3, allowlisted on test13.
VITE_ESCROW_REALM_PATH=gno.land/r/samcrew/escrow_v3
VITE_ENABLE_TOKENS=false
VITE_ENABLE_AGENTS=false

# Keep same-origin API requests deterministic and interceptable if this mobile
# regression test later needs to stub lane data. The current assertions remain
# intentionally independent of live listing content.
VITE_API_URL=http://localhost:5176
